#include "common.dtsi"

/* Runtime periods and calibrated pulses come from motor_output.h. */
&valve1 { pwms = <&ledc0 0 PWM_USEC(5050) PWM_POLARITY_NORMAL>; };
&valve2 { pwms = <&ledc0 1 PWM_USEC(5050) PWM_POLARITY_NORMAL>; };
&valve3 { pwms = <&ledc0 2 PWM_USEC(5050) PWM_POLARITY_NORMAL>; };
&valve4 { pwms = <&ledc0 3 PWM_USEC(5050) PWM_POLARITY_NORMAL>; };
&pinctrl {
    valve_pwm: valve_pwm {
        group1 {
            pinmux = <LEDC_CH0_GPIO4>, <LEDC_CH1_GPIO6>,
                     <LEDC_CH2_GPIO8>, <LEDC_CH3_GPIO15>;
            output-enable;
        };
    };
};
&ledc0 {
    pinctrl-0 = <&valve_pwm>;
    pinctrl-names = "default";
};
